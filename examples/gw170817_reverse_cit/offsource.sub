# 20 jobs x 5 off-source trials = 100 trials (submit from ~/raven_kn_reverse on CIT)
universe              = vanilla
executable            = offsource.sh
arguments             = $(first) 5
accounting_group      = ligo.dev.o4.cbc.grb.cohptfoffline
accounting_group_user = daniel.sentenac
request_cpus          = 1
request_memory        = 3 GB
request_disk          = 2 GB
+DESIRED_Sites        = "LIGO-CIT"
# run on CIT local nodes too (else only IGWN glideins)
+flock_local          = True
MY.POOLS              = "IGWN,CIT"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files  = raven_kn, gw170817_reverse_offsource.py, SSS17a_targeted_search_request.json, frames/H-H1_GWOSC_4KHZ_R1-1187006835-4096.gwf, frames/L-L1_GWOSC_4KHZ_R1-1187006835-4096.gwf, frames/V-V1_GWOSC_4KHZ_R1-1187006835-4096.gwf
transfer_output_files = chunk_$(first).json
transfer_output_remaps = "chunk_$(first).json = out/chunk_$(first).json"
output                = logs/offsource_$(first).out
error                 = logs/offsource_$(first).err
log                   = logs/offsource.log
queue first from seq 0 5 95 |
