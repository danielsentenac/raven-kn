universe              = vanilla
executable            = pygrb_inspiral.sh
arguments             = $(bank)
accounting_group      = ligo.dev.o4.cbc.grb.cohptfoffline
accounting_group_user = daniel.sentenac
request_cpus          = 1
request_memory        = 10 GB
request_disk          = 8 GB
+DESIRED_Sites        = "LIGO-CIT"
# run on CIT local nodes too (else only IGWN glideins)
MY.POOLS              = "IGWN,CIT"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
# FRAMES: the frame files of the caches (prepare.sh writes frames.txt): condor_submit FRAMES="$(cat frames.txt)" pygrb_inspiral.sub
transfer_input_files  = H1.cache, L1.cache, V1.cache, sky_grid.h5, bank/BANK$(bank).hdf, $(FRAMES)
transfer_output_files = INSPIRAL_BANK$(bank).hdf
transfer_output_remaps = "INSPIRAL_BANK$(bank).hdf = out/INSPIRAL_BANK$(bank).hdf"
output                = logs/inspiral_$(bank).out
error                 = logs/inspiral_$(bank).err
log                   = logs/inspiral.log
queue bank from seq 0 3 |
