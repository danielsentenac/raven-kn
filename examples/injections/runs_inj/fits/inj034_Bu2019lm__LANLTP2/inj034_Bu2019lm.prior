log10_mej_dyn = Uniform(name='log10_mej_dyn', minimum=-3., maximum=-1.)
vej_dyn = Uniform(name='vej_dyn', minimum=0.05, maximum=0.3)
log10_mej_wind = Uniform(name='log10_mej_wind', minimum=-3., maximum=-1.)
vej_wind = Uniform(name='vej_wind', minimum=0.05, maximum=0.3)
timeshift = Uniform(minimum=0.00100, maximum=6.89693, name='timeshift')
luminosity_distance = TruncatedGaussian(mu=108.618, sigma=4.601, minimum=81.013, maximum=136.223, name='luminosity_distance')
inclination_EM = Sine(minimum=0., maximum=1.570796, name='inclination_EM')
