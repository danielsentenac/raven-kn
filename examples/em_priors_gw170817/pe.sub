# After search_free_targeted_result.json is back: parameter estimation with and without the EM priors
universe              = vanilla
executable            = job.sh
arguments             = pe $(mode) 8
accounting_group      = ligo.dev.o4.cbc.grb.cohptfoffline
accounting_group_user = daniel.sentenac
request_cpus          = 8
request_memory        = 8 GB
request_disk          = 3 GB
+DESIRED_Sites        = "LIGO-CIT"
+flock_local          = True
MY.POOLS              = "IGWN,CIT"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
G                     = GWOSC_4KHZ_R1-1187006835-4096.gwf
transfer_input_files  = raven_kn, SSS17a_targeted_search_request.json, search_free_targeted_result.json, frames/H-H1_$(G), frames/V-V1_$(G), clean/L-L1_LOSC_CLN_4_V1-1187007040-2048.gwf
transfer_output_files = SSS17a_pe_$(mode)_pe_summary.json, SSS17a_pe_$(mode)_result.json
output                = logs/pe_$(mode).out
error                 = logs/pe_$(mode).err
log                   = logs/jobs.log
queue mode from (
  em
  gw
)
