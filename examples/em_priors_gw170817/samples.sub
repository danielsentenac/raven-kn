# Same distance-prior search and EM parameter estimation with the joint distance-inclination samples
# of the kilonova posterior (samples/) instead of the intervals of the request
universe              = vanilla
executable            = job.sh
arguments             = $(kind) $(mode) 8
accounting_group      = ligo.dev.o4.cbc.grb.cohptfoffline
accounting_group_user = daniel.sentenac
request_cpus          = $(cpus)
request_memory        = 8 GB
request_disk          = 3 GB
+DESIRED_Sites        = "LIGO-CIT"
+flock_local          = True
MY.POOLS              = "IGWN,CIT"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
G                     = GWOSC_4KHZ_R1-1187006835-4096.gwf
transfer_input_files  = raven_kn, samples, search_free_targeted_result.json, frames/H-H1_$(G), frames/V-V1_$(G), $(l1)
transfer_output_files = $(outputs)
output                = logs/$(kind)_$(mode).out
error                 = logs/$(kind)_$(mode).err
log                   = logs/jobs.log
queue kind, mode, cpus, l1, outputs from (
  search distance_samples 1 frames/L-L1_GWOSC_4KHZ_R1-1187006835-4096.gwf search_distance_samples_targeted_result.json
  pe em_samples 8 clean/L-L1_LOSC_CLN_4_V1-1187007040-2048.gwf SSS17a_samples_pe_em_pe_summary.json,SSS17a_samples_pe_em_result.json
)
