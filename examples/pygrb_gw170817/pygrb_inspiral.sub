universe              = vanilla
executable            = pygrb_inspiral.sh
arguments             = $(bank)
accounting_group      = ligo.dev.o4.cbc.grb.cohptfoffline
accounting_group_user = daniel.sentenac
request_cpus          = 1
request_memory        = 6 GB
request_disk          = 2 GB
+DESIRED_Sites        = "LIGO-CIT"
# run on CIT local nodes too (else only IGWN glideins, which never came)
+flock_local          = True
MY.POOLS              = "IGWN,CIT"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files  = frames/H-H1_GWOSC_4KHZ_R1-1187006835-4096.gwf, frames/L-L1_GWOSC_4KHZ_R1-1187006835-4096.gwf, frames/V-V1_GWOSC_4KHZ_R1-1187006835-4096.gwf, sky_grid.h5, bank/BANK$(bank).hdf
transfer_output_files = INSPIRAL_BANK$(bank).hdf
transfer_output_remaps = "INSPIRAL_BANK$(bank).hdf = out/INSPIRAL_BANK$(bank).hdf"
output                = logs/inspiral_$(bank).out
error                 = logs/inspiral_$(bank).err
log                   = logs/inspiral.log
queue bank from seq 0 3 |
