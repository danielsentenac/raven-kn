# Coherent statistic restricted to a circular polarisation (calibrated strain, pipeline template);
# the unrestricted run is <event>_hoft_tmpl_coherent of light_search.sub
universe              = vanilla
executable            = light_search.sh
arguments             = $(ev) $(kind) $(bank) $(stat) $(pol)
accounting_group      = ligo.dev.o4.cbc.grb.cohptfoffline
accounting_group_user = daniel.sentenac
request_cpus          = 1
request_memory        = 6 GB
request_disk          = 2 GB
+DESIRED_Sites        = "LIGO-CIT"
+flock_local          = True
MY.POOLS              = "IGWN,CIT"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files  = raven_kn, events.json, manifest_$(ev)_$(kind).json, frames_$(ev)_$(kind)
transfer_output_files = $(ev)_$(kind)_$(bank)_$(stat)_$(pol)_targeted_result.json
output                = logs/$(ev)_$(kind)_$(bank)_$(stat)_$(pol).out
error                 = logs/$(ev)_$(kind)_$(bank)_$(stat)_$(pol).err
log                   = logs/light_search.log
queue ev, kind, bank, stat, pol from (
  S250720j hoft tmpl coherent circular
  S250720j hoft tmpl coherent face_on
  S250720j hoft tmpl coherent face_away
  S250818k hoft tmpl coherent circular
  S250818k hoft tmpl coherent face_on
  S250818k hoft tmpl coherent face_away
  S251112cm hoft tmpl coherent circular
  S251112cm hoft tmpl coherent face_on
  S251112cm hoft tmpl coherent face_away
)
