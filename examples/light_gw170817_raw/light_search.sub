# condor_submit light_search.sub   (after ./prepare.sh)
universe              = vanilla
executable            = light_search.sh
arguments             = $(kind)
accounting_group      = ligo.dev.o4.cbc.grb.cohptfoffline
accounting_group_user = daniel.sentenac
request_cpus          = 1
request_memory        = 6 GB
request_disk          = 2 GB
+DESIRED_Sites        = "LIGO-CIT"
# run on CIT local nodes too (else only IGWN glideins)
MY.POOLS              = "IGWN,CIT"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files  = raven_kn, SSS17a_targeted_search_request.json, manifest_$(kind).json, frames_$(kind)
transfer_output_files = SSS17a_GRB_window_$(kind)_targeted_result.json
output                = logs/light_search_$(kind).out
error                 = logs/light_search_$(kind).err
log                   = logs/light_search.log
# raw3 needs virgo_lyon.sh (at CC-IN2P3) and add_virgo.py first
queue kind in raw, hoft, raw3
